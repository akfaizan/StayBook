<% layout("/layouts/boilerplate") -%>

    <!-- Filter Bar -->
<div class="filter-bar">

    <!-- Categories -->
    <div class="filter-items">

    <a href="/listings?category=Trending" class="filter-item">
        <i class="fa-solid fa-fire"></i>
        <span>Trending</span>
    </a>

    <a href="/listings?category=Beach" class="filter-item">
        <i class="fa-solid fa-umbrella-beach"></i>
        <span>Beach</span>
    </a>

    <a href="/listings?category=Mountains" class="filter-item">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
    </a>

    <a href="/listings?category=Cabins" class="filter-item">
        <i class="fa-solid fa-house"></i>
        <span>Cabins</span>
    </a>

    <a href="/listings?category=Camping" class="filter-item">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
    </a>

    <a href="/listings?category=Lakefront" class="filter-item">
        <i class="fa-solid fa-water"></i>
        <span>Lakefront</span>
    </a>

    <a href="/listings?category=Countryside" class="filter-item">
        <i class="fa-solid fa-tree"></i>
        <span>Countryside</span>
    </a>

    <a href="/listings?category=City" class="filter-item">
        <i class="fa-solid fa-city"></i>
        <span>City</span>
    </a>

    <a href="/listings?category=Castles" class="filter-item">
        <i class="fa-solid fa-chess-rook"></i>
        <span>Castles</span>
    </a>

    <a href="/listings?category=Islands" class="filter-item">
        <i class="fa-solid fa-tree"></i>
        <span>Islands</span>
    </a>

    <a href="/listings?category=Tropical" class="filter-item">
        <i class="fa-solid fa-sun"></i>
        <span>Tropical</span>
    </a>

    <a href="/listings?category=Desert" class="filter-item">
        <i class="fa-solid fa-sun"></i>
        <span>Desert</span>
    </a>

    <a href="/listings?category=Farms" class="filter-item">
        <i class="fa-solid fa-wheat-awn"></i>
        <span>Farms</span>
    </a>

    <a href="/listings?category=AmazingViews" class="filter-item">
        <i class="fa-solid fa-panorama"></i>
        <span>Amazing views</span>
    </a>

</div>


    <!-- Tax Toggle -->
    <div class="tax-toggle">
    <div class="form-check form-switch">
        <input
            class="form-check-input"
            type="checkbox"
            role="switch"
            id="taxSwitch"
        >

        <label class="form-check-label" for="taxSwitch">
            Display total with taxes
        </label>
    </div>
    </div>

</div>    

     <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <%for(let list of allListings){%>
        <a href="/listings/<%= list._id %>" class="listing-link">
        <div class="card col listing-card" >
        <div class="card-img-overlay"></div>
        <img src="<%= list.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem" >
        <div class="card-body">
            <p class="card-text">
                <b><%= list.title %></b>
                <br>
            </p>
            <p class=" card-text listing-price">
                &#x20B9;
                <span
                    class="price-value"
                    data-base-price="<%= list.price %>"
                >
                    <%= list.price %>
                </span>
                / night

                <span class="tax-text">18% tax included</span>
            </p>
        </div>
        </div>
        </a>
    <%}%>
    </div>

<script>
    const taxSwitch = document.querySelector("#taxSwitch");

    const prices = document.querySelectorAll(".price-value");
    const taxTexts = document.querySelectorAll(".tax-text");

    const taxRate = 0.18;

    taxSwitch.addEventListener("change", () => {

        prices.forEach((price, index) => {

            const basePrice = Number(price.dataset.basePrice);

            if (taxSwitch.checked) {

                const priceWithTax = basePrice * (1 + taxRate);

                price.innerText = Math.round(priceWithTax);

                taxTexts[index].style.display = "inline";

            } else {

                price.innerText = basePrice;

                taxTexts[index].style.display = "none";
            }

        });

    });
</script>
